# 复制为 device.yaml 后按环境修改。

adb:
  host: "192.168.0.100"
  port: 5555
  # serial: "192.168.0.100:5555"
  adb_path: ""
  connect_timeout_sec: 15

capture:
  duration_sec: 15
  remote_dir: "/sdcard/echo_eval"
  remote_filename: "capture.mp4"
  local_dir: "artifacts"
  fps: 1
  ffmpeg_path: ""
  # scrcpy = 本机带声音录屏（推荐）；screenrecord = 旧 adb 无声录屏
  backend: scrcpy
  scrcpy_path: ""   # 留空则 PATH；例: C:/Users/.../scrcpy.exe
  # 华为 Android 12 穿刺：必须 AAC（默认 opus 会失败）
  # 目标机 Android 12：不用 --audio-source=playback（需 13+）
  scrcpy_audio_codec: aac
  scrcpy_audio_encoder: OMX.google.aac.encoder
  scrcpy_max_size: 1280
  scrcpy_video_bit_rate: "8M"
  scrcpy_require_audio: true
  scrcpy_extra_args: []

stimulus:
  enabled: false
  type: audio_file
  path: assets/audio/beep_1s.wav
  play_device: host
  start_delay_sec: 1.0

tts:
  # sapi | edge | file（edge 需出网，走 Microsoft Edge 在线神经音色）
  backend: edge
  voice: zh-CN-XiaoxiaoNeural
  rate: 0
  lookup_dir: ""
  # edge 连不上时回退本机 SAPI（仅 Windows）
  fallback_sapi: true
  # 预合成语音库；运行时优先命中库，未命中用本机 SAPI
  library_dir: assets/tts_library
  prefer_library: true

run:
  step_wait_sec: 3
  head_delay_sec: 1
  tail_sec: 5
  # 每条结束后按系统 Home，再等待后再开下一条（失败仅告警）
  return_home_after_case: true
  return_home_wait_sec: 2
  # 设备串行；抽帧+评判后台并行（false=恢复同步）
  judge_async: true
  judge_parallel: 3
  wake_enabled: true
  wake_text: "小翼管家"
  wake_wait_sec: 3.0

# ASR 准确率（P1）：与 GUI 成功率互不影响
# capture_mode: offline=从 capture.mp4 抽帧（推荐，字幕闪现更稳）
#               live=现场 adb 截屏；hybrid=现场不足再用视频补
asr:
  enabled: true
  capture_mode: offline
  interval_sec: 0.3
  window_sec: 8.0
  early_stop: false
  early_stop_stable_frames: 2
  bottom_band_ratio: 0.22
  # 多条用 | 分隔
  ignore_texts: "我还在听，说再见退出"

# 端到端时延（P2）
latency:
  enabled: true
  fps: 10
  window_sec: 8.0
  bottom_band_ratio: 0.22
  change_threshold: 6.0

# TTS MOS（P3）
# source: video=只从 mp4 抽（推荐，配合 scrcpy）；auto=可降级主机麦；host_mic=只主机麦
# ignore_non_speech: 忽略内录里疑似歌曲/视频床底，只对类语音段打分
# Windows 主机麦示例：
#   input_format: dshow
#   input_device: audio=Microphone (Realtek ...)
mos:
  enabled: true
  source: video
  ignore_non_speech: true
  window_sec: 5.0
  sample_rate: 16000
  min_speech_sec: 0.3
  input_format: "dshow"
  input_device: ""

# 预置条件：开跑前覆盖检查；每条正式测前 force-stop→Home→回放 ADB
precondition:
  enabled: true
  coverage_check: true
  # 回放后再 VL 验一次；false=已通过不用重新测试
  # 已 pass 一律回放 ADB；校准默认只跑未全部 pass 的用例（--force 重训已 pass）
  verify_after_replay: false
  max_retries: 3
  # 每步默认等待；可按步骤文案覆盖（精确匹配优先，其次子串）
  step_settle_sec: 1.0
  step_settle_overrides:
    打开爱奇艺: 8
    打开设置: 2
  cache_dir: artifacts/precondition_cache
  packages_path: configs/packages.yaml
