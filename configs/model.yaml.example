# 复制为 model.yaml 后填写真实密钥（或直接编辑 configs/model.yaml）。
# 结构与 TestAppGUI testApp/configs/model.yaml 一致。
# vl_eval 同时用于文本评判与截图 VL。

models:
  default: &doubao
    api_format: "openai"
    base_url: "https://YOUR_GATEWAY/v1"
    api_key: "YOUR_API_KEY"
    model_id: "YOUR_VL_MODEL_ID"
    temperature: 1
    timeout: 120
    max_retries: 3

  local:
    <<: *doubao

  vl_eval:
    <<: *doubao

  kimi25:
    <<: *doubao

  qwen122B:
    <<: *doubao

  qwen3.6-plus:
    <<: *doubao

  qwen27B:
    <<: *doubao

  qwen3_8B:
    <<: *doubao

  sili_qwen122B:
    <<: *doubao

  sili_qwen27B:
    <<: *doubao
    max_tokens: 4096
