<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- webserver 9527 使用 HTTP/WS，允许明文（含 IP 直连） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
