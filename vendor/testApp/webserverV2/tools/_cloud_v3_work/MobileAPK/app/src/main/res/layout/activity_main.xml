<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="2dp">

        <Button
            android:id="@+id/btn_config"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="56dp"
            android:text="配置"
            android:textSize="13sp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DeviceSDK V2 测试"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <!-- 占位保持居中 -->
        <View
            android:layout_width="56dp"
            android:layout_height="40dp"/>
    </LinearLayout>

    <!-- 位置权限状态 -->
    <TextView
        android:id="@+id/tv_location_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="位置权限: 检测中..."
        android:textSize="12sp"
        android:textColor="#FF9800"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <!-- 无障碍权限状态 -->
    <TextView
        android:id="@+id/tv_accessibility_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="无障碍权限: 检测中..."
        android:textSize="12sp"
        android:textColor="#FF9800"
        android:gravity="center"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- 录屏权限状态（MediaProjection，GUI 截图必需） -->
    <TextView
        android:id="@+id/tv_media_projection_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="录屏权限: 检测中..."
        android:textSize="12sp"
        android:textColor="#FF9800"
        android:gravity="center"
        android:layout_marginBottom="4dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- 后台弹出界面（小米：用例结束后自拉回 Demo，无需 HOME 点图标） -->
    <TextView
        android:id="@+id/tv_background_popup_permission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="后台弹出权限: 检测中..."
        android:textSize="12sp"
        android:textColor="#FF9800"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- 功能按钮区 -->
    <!-- 行1: 登录 + 登出 + 查询 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btn_login"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/login"
            android:textSize="13sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="@string/logout"
            android:textSize="13sp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_query_login_info"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="查询"
            android:textSize="13sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- 行2: QA + 功能测试 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btn_qa"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="QA"
            android:textSize="13sp"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn_api_test"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="功能测试"
            android:textSize="13sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- 清屏按钮：放在日志上方，宽度100% -->
    <Button
        android:id="@+id/btn_clear_log"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="清屏"
        android:textSize="13sp"
        android:layout_marginBottom="6dp"/>

    <ScrollView
        android:id="@+id/scroll_view_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#f5f5f5"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="日志输出:\n"
            android:textSize="14sp"
            android:fontFamily="monospace"/>
    </ScrollView>

</LinearLayout>
