<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_qa_dialog_window"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="会话管理"
        android:textColor="@color/qa_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="点击切换；勾选后可批量删除；列表可滑动"
        android:textColor="@color/qa_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/layout_session_select_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/cb_session_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全选"
            android:textColor="@color/qa_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_session_selected_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textColor="@color/qa_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btn_session_delete_selected"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_qa_dialog_btn_secondary"
            android:clickable="true"
            android:enabled="false"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="删除所选"
            android:textColor="@color/qa_danger"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 固定最大高度，避免会话多时把底部「新增会话」顶出屏幕 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp">

        <ListView
            android:id="@+id/list_sessions"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:divider="@color/qa_divider"
            android:dividerHeight="1dp"
            android:fadeScrollbars="false"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/tv_session_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:text="暂无会话"
            android:textColor="@color/qa_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/qa_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_session_close"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_qa_dialog_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="关闭"
            android:textColor="@color/qa_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_session_new"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_qa_dialog_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="新增会话"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
