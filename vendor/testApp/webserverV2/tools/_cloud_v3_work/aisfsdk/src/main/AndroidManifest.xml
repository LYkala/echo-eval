<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.huawei.aisfsdk">

    <!-- 网络相关 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 定位相关 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 前台服务相关 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 无障碍服务，GUI场景需要使用 -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />

    <!-- 系统功能相关 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+ 查询应用安装状态 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Android 11+ 拉起其他应用需要声明 queries -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <package android:name="com.huawei.appmarket" />
        <package android:name="com.xiaomi.market" />
        <package android:name="com.oppo.market" />
        <package android:name="com.bbk.appstore" />
        <package android:name="com.tencent.android.qqdownloader" />
    </queries>

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:allowBackup">
        <activity
            android:name=".util.RequestPermissionActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name="com.huawei.aisfsdkv2.component.androidfunc.permission.PermissionRequestActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name="com.huawei.aisfsdkv2.component.androidfunc.accessibility.impl.AccessibilityManagerImpl"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <service
            android:name="com.huawei.aisfsdkv2.component.androidfunc.screenshot.MediaScreenshotService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>