<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- 位置权限（SDK需要） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    
    <!-- 拉起应用市场需要的权限 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    
    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <!-- 通知权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- 无障碍服务权限 -->
    <uses-permission android:name="android.permission.BIND_ACCESSIBILITY_SERVICE" />
    
    <!-- 悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    
    <!-- Android 11+ 拉起其他应用需要声明 queries -->
    <queries>
        <!-- 应用市场 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <!-- 华为应用市场 -->
        <package android:name="com.huawei.appmarket" />
        <!-- 小米应用商店 -->
        <package android:name="com.xiaomi.market" />
        <!-- OPPO 应用商店 -->
        <package android:name="com.oppo.market" />
        <!-- VIVO 应用商店 -->
        <package android:name="com.bbk.appstore" />
        <!-- 腾讯应用宝 -->
        <package android:name="com.tencent.android.qqdownloader" />
        <!-- TestApp：ContentProvider 投递 AIS 回复 -->
        <package android:name="com.example.testapp" />
        <provider android:authorities="com.example.testapp.testreply" />
    </queries>

    <application
        android:name=".DemoApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeviceSDKDemo">
        <activity
            android:name=".ConfigActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"/>
        <activity
            android:name=".QAActivity"
            android:exported="false"
            android:label="QA对话"/>
        <activity
            android:name=".MemoryTestActivity"
            android:exported="false"
            android:label="记忆测试"/>
        <activity
            android:name=".SkillTestActivity"
            android:exported="false"
            android:label="技能测试"/>
        <activity
            android:name=".ImitateTestActivity"
            android:exported="false"
            android:label="仿真测试"/>
        <activity
            android:name=".ApiTestActivity"
            android:exported="false"
            android:label="接口测试"/>
        <activity
            android:name=".LocationTestActivity"
            android:exported="false"
            android:label="地理位置测试"/>
        <activity
            android:name=".TongtongTaskTestActivity"
            android:exported="false"
            android:label="通通任务测试"/>
        <activity
            android:name=".LogTestActivity"
            android:exported="false"
            android:label="Log测试"/>
        <activity
            android:name=".SessionTestActivity"
            android:exported="false"
            android:label="会话管理测试"/>

        <!-- Demo 前台服务 -->
        <service
            android:name=".DemoForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- TestApp 跨进程同步截图（绕过小米对 cached 广播的冻结） -->
        <provider
            android:name=".GuiCaptureProvider"
            android:authorities="com.example.devicesdkdemo.gui_capture"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- 文本输入广播接收器 (用于 ADB 自动化测试) -->
        <receiver
            android:name=".TextInputReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.devicesdkdemo.ACTION_INPUT_TEXT" />
                <action android:name="com.example.devicesdkdemo.ACTION_SEND_TEXT" />
            </intent-filter>
        </receiver>

            <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
